+        BareLayout.KvRow AngleRow(int index, string label, double degrees, string positive, string negative, Color accent)
+        {
+            return new BareLayout.KvRow
+            {
+                Label = label,
+                Value = AngleText(index, degrees, positive, negative),
+                ValueColor = ToleranceColor(degrees, ALIGN_TOLERANCE_DEGREES, accent),
+                Bar = -1f
+            };
+        }
+
+        string AngleText(int index, double degrees, string positive, string negative)
+        {
+            var quantized = (int)Math.Round(degrees * 10d);
+            if (_angleTexts[index] != null && _angleQuantized[index] == quantized)
+                return _angleTexts[index];
+
+            _angleQuantized[index] = quantized;
+            _angleTexts[index] = string.Format("{0} {1:0.0}°", degrees < 0d ? negative : positive, Math.Abs(degrees));
+            return _angleTexts[index];
+        }
+
+        string DistanceText(double dockingAxisDistance)
+        {
+            var quantized = (int)Math.Round(dockingAxisDistance * 100d);
+            if (_distanceText != null && _distanceQuantized == quantized)
+                return _distanceText;
+
+            _distanceQuantized = quantized;
+            _distanceText = FormatingHelper.DistanceToString((float)dockingAxisDistance);
+            return _distanceText;
+        }
+
+        Color ToleranceColor(double value, double tolerance, Color accent)
+        {
+            var abs = Math.Abs(value);
+            if (abs <= tolerance)
+                return accent;
+
+            return abs <= tolerance * TOLERANCE_WARNING_FACTOR ? GetWarningColor() : GetErrorColor();
+        }
+
+        string StateWord(Vector3D positionOffset, Vector3D rotationOffset)
+        {
+            var connector = _referenceBlock as IMyShipConnector;
+            if (connector != null && connector.Status == MyShipConnectorStatus.Connected)
+                return _stateConnected;
+
+            if (connector != null && connector.Status == MyShipConnectorStatus.Connectable)
+                return _stateReady;
+
+            bool aligned = Math.Abs(positionOffset.X) <= ALIGN_TOLERANCE_METERS &&
+                           Math.Abs(positionOffset.Y) <= ALIGN_TOLERANCE_METERS &&
+                           Math.Abs(rotationOffset.X) <= ALIGN_TOLERANCE_DEGREES &&
+                           Math.Abs(rotationOffset.Y) <= ALIGN_TOLERANCE_DEGREES &&
+                           Math.Abs(rotationOffset.Z) <= ALIGN_TOLERANCE_DEGREES;
+            return aligned ? _stateAligned : _stateAdjust;
+        }
