+                float side = Math.Min(view.Width * 0.5f, view.Height);
+                square = new RectangleF(view.X, view.Center.Y - side * 0.5f, side, side);
+                heroArea = new RectangleF(square.Right + margin, view.Y, view.Right - square.Right - margin, view.Height);
