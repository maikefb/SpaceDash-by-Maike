+            AddTexture(_sprites, "CircleHollow", marker, new Vector2(markerSize * BARE_TARGET_RING_SCALE), targetColor, 0f);
+
+            Bare.Hero(_sprites, DistanceText(dockingAxisDistance), heroArea, BARE_HERO_FONT_MUL, fg);
