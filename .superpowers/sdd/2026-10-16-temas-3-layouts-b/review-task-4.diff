+        void DrawMinimal(List<MySprite> sprites)
+        {
+            var view = ViewBox;
+            Color fg = Host.ForegroundColor;
+            Color accent = GetHeaderColor();
+            Color warning = GetWarningColor();
+            Color error = GetErrorColor();
+            Color track = Color.Lerp(BackgroundColor, fg, RING_TRACK_MIX);
+            int intact = _blocks.Count - Damaged;
+            bool valid = BlueprintTotal > 0;
+            float total = valid ? BlueprintTotal : 1f;
+            _segments[0] = new DonutSegment(intact / total, accent);
+            _segments[1] = new DonutSegment(Damaged / total, warning);
+            _segments[2] = new DonutSegment(Destroyed / total, error);
+            Color centerColor = valid ? DamageColor(accent) : fg;
+            string center = valid ? FormatingHelper.PercentageToString(intact / total) : null;
+            string line2 = valid ? string.Format(Label("BlocksNetworks"), _blocks.Count, NetworkCount()) : null;
+            float margin = Bare.Margin;
+            float lineHeight = Bare.LineHeight(1f);
+
+            if (BareLayout.IsWide(view))
+            {
+                var ringArea = new RectangleF(view.X, view.Y, view.Width * 0.5f, view.Height);
+                Bare.Ring(sprites, ringArea, _segments, track, center, centerColor, MINIMAL_HERO_FONT_MUL);
+                float left = ringArea.Right + margin;
+                float textTop = view.Center.Y - lineHeight;
+                if (valid)
+                    DrawCounts(sprites, left, textTop, view.Right - left, lineHeight, false, intact, fg, warning, error);
+                Bare.Text(sprites, line2, new Vector2(left, textTop + lineHeight), TextAlignment.LEFT, 1f, fg, view.Right - left, lineHeight);
+                return;
+            }
+
+            float textBlock = lineHeight * 2f + margin;
+            float ringSide = Math.Min(view.Width, view.Height - textBlock);
+            if (ringSide < textBlock)
+            {
+                Bare.Ring(sprites, view, _segments, track, center, centerColor, MINIMAL_HERO_FONT_MUL);
+                return;
+            }
+
+            float top = view.Y + (view.Height - ringSide - textBlock) * 0.5f;
+            var ring = new RectangleF(view.X, top, view.Width, ringSide);
+            Bare.Ring(sprites, ring, _segments, track, center, centerColor, MINIMAL_HERO_FONT_MUL);
+            float linesTop = ring.Bottom + margin;
+            if (valid)
+                DrawCounts(sprites, view.Center.X, linesTop, view.Width, lineHeight, true, intact, fg, warning, error);
+            Bare.Text(sprites, line2, new Vector2(view.Center.X, linesTop + lineHeight), TextAlignment.CENTER, 1f, fg, view.Width, lineHeight);
+        }
