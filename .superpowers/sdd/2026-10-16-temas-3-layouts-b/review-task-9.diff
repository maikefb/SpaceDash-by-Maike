+                    _plantIcon = entry.OutputSprite;
+                if (entry.IsReady)
+                    _ready++;
+                else if (entry.RemainingSeconds >= 0d && (_next == null || entry.RemainingSeconds < _next.RemainingSeconds))
+                    _next = entry;
