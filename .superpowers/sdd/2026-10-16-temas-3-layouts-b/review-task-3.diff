+                    if (grid.CubeExists(grid.WorldToGridInteger(projected.GridIntegerToWorld(_projected[j].Position))))
+                        matches++;
+                if ((float)matches / _projected.Count >= 0.5f)
+                    return projector;
+            }
+            _projected.Clear();
