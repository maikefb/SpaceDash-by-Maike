<?xml version="1.0" encoding="utf-8"?>
<Definitions xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:xsd="http://www.w3.org/2001/XMLSchema">
    <LCDTextures>

        <LCDTextureDefinition> <!-- Remap of Vanilla Broadcasting sprite -->
            <Id Type="LCDTextureDefinition" Subtype="BroadcastingOn"/>
            <SpritePath>Textures/Sprites/Hud/GridBroadcastingOn.dds</SpritePath>
            <Selectable>false</Selectable>
        </LCDTextureDefinition>


        <LCDTextureDefinition> <!-- Remap of Vanilla Broadcasting Off sprite -->
            <Id Type="LCDTextureDefinition" Subtype="BroadcastingOff"/>
            <SpritePath>Textures/Sprites/Hud/GridBroadcastingOff.dds</SpritePath>
            <Selectable>false</Selectable>
        </LCDTextureDefinition>


        <LCDTextureDefinition> <!-- Remap of Vanilla Antenna sprite -->
            <Id Type="LCDTextureDefinition" Subtype="RadioAntenna"/>
            <SpritePath>Textures/Sprites/Hud/SignalMode.dds</SpritePath>
            <Selectable>false</Selectable>
        </LCDTextureDefinition>


        <LCDTextureDefinition> <!-- Remap of Vanilla Power sprite -->
            <Id Type="LCDTextureDefinition" Subtype="GridPower"/>
            <SpritePath>Textures/Sprites/Hud/GridPowerOnCenter.dds</SpritePath>
            <Selectable>false</Selectable>
        </LCDTextureDefinition>


        <LCDTextureDefinition> <!-- Remap of Vanilla Rotation Plane sprite -->
            <Id Type="LCDTextureDefinition" Subtype="RotationPlane"/>
            <SpritePath>Textures/Sprites/Hud/RotationPlane.dds</SpritePath>
            <Selectable>false</Selectable>
        </LCDTextureDefinition>


        <LCDTextureDefinition> <!-- Remap of Vanilla Disconnected sprite -->
            <Id Type="LCDTextureDefinition" Subtype="Disconnected"/>
            <SpritePath>Textures/Sprites/Hud/ToggleConnectors.dds</SpritePath>
            <Selectable>false</Selectable>
        </LCDTextureDefinition>


        <LCDTextureDefinition> <!-- Remap of Vanilla Cursor sprite -->
            <Id Type="LCDTextureDefinition" Subtype="CursorDefault"/>
            <SpritePath>Textures/GUI/MouseCursor.dds</SpritePath>
            <Selectable>false</Selectable>
        </LCDTextureDefinition>


        <LCDTextureDefinition> <!-- Remap of Vanilla Loading sprite -->
            <Id Type="LCDTextureDefinition" Subtype="CursorWaitCursor"/>
            <SpritePath>Textures/Sprites/Hud/RadialMenu.dds</SpritePath>
            <Selectable>false</Selectable>
        </LCDTextureDefinition>






        <LCDTextureDefinition> <!-- Remap of Vanilla temperature sprite typo -->
            <Id Type="LCDTextureDefinition" Subtype="IconTemperature"/>
            <SpritePath>Textures/Sprites/Hud/OusideTemp.dds</SpritePath>
            <Selectable>false</Selectable>
        </LCDTextureDefinition>

    </LCDTextures>
</Definitions>
